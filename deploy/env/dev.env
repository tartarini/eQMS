# Development settings for compose.yaml. Not secret; never use these values in production.
DJANGO_DEBUG=1
DJANGO_SECRET_KEY=dev-only-insecure-key-do-not-use-in-production
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,app
DATABASE_URL=postgres://qms:qms@db:5432/qms
DJANGO_EMAIL_HOST=mail
DJANGO_EMAIL_PORT=1025
DJANGO_EMAIL_TLS=0
DJANGO_FROM_EMAIL=samd-qms@localhost
QMS_BASE_URL=http://localhost:8000
QMS_ALERT_EMAILS=ops@localhost
QMS_SSO_ALLOWED_DOMAINS=
QMS_MIGRATE_ON_START=1
BACKUP_RETENTION_DAYS=7
