# Production application settings. Ansible renders this as /opt/samd_qms/app.env (mode 0600)
# from deploy/ansible/group_vars; this example shows every setting. Never commit real values.

DJANGO_SECRET_KEY=change-me-50-random-characters
DJANGO_LOG_LEVEL=INFO

# Email (SMTP relay)
DJANGO_EMAIL_HOST=smtp.example.org
DJANGO_EMAIL_PORT=587
DJANGO_EMAIL_USER=samd-qms@example.org
DJANGO_EMAIL_PASSWORD=change-me
DJANGO_EMAIL_TLS=1
DJANGO_FROM_EMAIL=samd-qms@example.org
# Alerts when a scheduled job (backup, audit verification...) fails
QMS_ALERT_EMAILS=it-ops@example.org,qa@example.org

# Single sign-on: set only the providers you use (see README for callback URLs)
QMS_SSO_ALLOWED_DOMAINS=example.org
SSO_MICROSOFT_CLIENT_ID=
SSO_MICROSOFT_SECRET=
SSO_MICROSOFT_TENANT=organizations
SSO_GOOGLE_CLIENT_ID=
SSO_GOOGLE_SECRET=
SSO_GITHUB_CLIENT_ID=
SSO_GITHUB_SECRET=
SSO_ORCID_CLIENT_ID=
SSO_ORCID_SECRET=
SSO_LINKEDIN_CLIENT_ID=
SSO_LINKEDIN_SECRET=

# Backups kept on the server (days); copy them off-site too (Ansible: backup_offsite_*)
BACKUP_RETENTION_DAYS=30
GUNICORN_WORKERS=3

# Account requests from the home page: captcha back end ("pow" = self-hosted, no keys;
# "turnstile" = Cloudflare Turnstile with the two keys below).
QMS_CAPTCHA=pow
QMS_TURNSTILE_SITE_KEY=
QMS_TURNSTILE_SECRET_KEY=
