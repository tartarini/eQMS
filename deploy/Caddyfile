# HTTPS reverse proxy. Caddy obtains and renews the TLS certificate automatically
# (Let's Encrypt) for QMS_DOMAIN; ports 80 and 443 must be reachable from the internet.
#
# Django admin (/admin/) is not served on the public site (finding F7). It is reachable only
# through an SSH tunnel to the second site below, which Compose publishes on the server's
# loopback interface (127.0.0.1:8443) and nowhere else: scripts/remote.sh tunnel.
{
	email {$ACME_EMAIL}
	skip_install_trust
}

{$QMS_DOMAIN} {
	encode zstd gzip

	# Uploads and document files are limited to 25 MB by the app; allow a margin.
	request_body {
		max_size 30MB
	}

	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		X-Content-Type-Options "nosniff"
		Referrer-Policy "same-origin"
		Permissions-Policy "camera=(), microphone=(), geolocation=()"
		-Server
	}

	# Uploaded files are only ever served through login-protected app views.
	@media path /media/*
	respond @media 404

	# Administration only through the SSH tunnel (site below).
	@admin path /admin /admin/*
	respond @admin 404

	reverse_proxy app:8000 {
		health_uri /healthz
		health_interval 30s
	}

	log {
		output stdout
		format json
	}
}

# Administration site for SSH tunnels: https://localhost:8443/admin/ on the operator's machine.
# Caddy's own internal CA signs the certificate, so the browser warns once; that is expected.
https://localhost:8443 {
	tls internal

	header {
		X-Content-Type-Options "nosniff"
		Referrer-Policy "same-origin"
		-Server
	}

	@media path /media/*
	respond @media 404

	# No HSTS here: it would pin every localhost port to HTTPS in the operator's browser,
	# breaking local development servers.
	reverse_proxy app:8000 {
		header_down -Strict-Transport-Security
	}

	log {
		output stdout
		format json
	}
}
