# {{ ansible_managed }}
DJANGO_SECRET_KEY={{ vault_django_secret_key }}
DJANGO_LOG_LEVEL=INFO
DJANGO_EMAIL_HOST={{ smtp_host }}
DJANGO_EMAIL_PORT={{ smtp_port }}
DJANGO_EMAIL_USER={{ smtp_user }}
DJANGO_EMAIL_PASSWORD={{ vault_smtp_password }}
DJANGO_EMAIL_TLS={{ '1' if smtp_tls else '0' }}
DJANGO_FROM_EMAIL={{ from_email }}
QMS_ALERT_EMAILS={{ alert_emails }}
QMS_SSO_ALLOWED_DOMAINS={{ qms_sso_allowed_domains }}
BACKUP_RETENTION_DAYS={{ backup_retention_days }}
GUNICORN_WORKERS={{ gunicorn_workers }}
{% for p in ['microsoft', 'google', 'github', 'orcid', 'linkedin'] %}
{%   set cid = lookup('vars', 'sso_' ~ p ~ '_client_id') %}
{%   if cid %}
SSO_{{ p | upper }}_CLIENT_ID={{ cid }}
SSO_{{ p | upper }}_SECRET={{ lookup('vars', 'vault_sso_' ~ p ~ '_secret') }}
{%   endif %}
{% endfor %}
{% if sso_microsoft_client_id %}
SSO_MICROSOFT_TENANT={{ sso_microsoft_tenant }}
{% endif %}
